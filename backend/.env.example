# Copy to backend/.env (Bun loads it). The backend refuses to boot and lists every missing or invalid variable.

# Public origin of the web app (bare origin, no path). https here turns on Secure cookies.
APP_ORIGIN=http://localhost:3000
# Base the browser uses for the realtime socket: ws(s)://<backend host>. /realtime?ticket=... is appended.
REALTIME_URL=ws://localhost:8787
PORT=8787
# Optional bind address (Bun default: all interfaces).
# HOST=127.0.0.1

# 32 random bytes each, base64. Must differ. Generate: openssl rand -base64 32
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# GitHub OAuth App. Callback URL: <APP_ORIGIN>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Overrides for GitHub Enterprise or local test doubles.
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# Terse durable actors (durable-actors dev listens on 127.0.0.1:7100). Same secret the dev server runs with.
# Use hex (openssl rand -hex 32): a value starting with "-" breaks the dev server argument parsing.
DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7100
DURABLE_ACTORS_SECRET=
# DURABLE_ACTORS_PROJECT_ID=local

# Optional. Without it, environment (VM) features report as disabled in GET /api/me.
FREESTYLE_API_KEY=
# FREESTYLE_BASE_SNAPSHOT=morrow-base

# Hosted Relaycast by default. Point at a self-hosted engine, or set to "disabled".
# RELAY_BASE_URL=https://cast.agentrelay.com

# Invite-only sign-in: comma-separated GitHub logins. Unset means anyone with GitHub can sign in.
# SIGNUP_ALLOWLIST=ada,linus
# Pre-auth rate limits key on the client IP. Set to the number of proxies in front of the backend that APPEND
# the caller to X-Forwarded-For (nginx, Caddy, a load balancer); the IP is read that many hops from the right.
# 0 = socket peer. Next's /api rewrite appends nothing (it passes the browser's header through), so it never counts.
# TRUSTED_PROXY_HOPS=0
# LOG_LEVEL=info
