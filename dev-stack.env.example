# Copy to dev-stack.env (stays on your machine, never in the repo) and run: chmod 600 dev-stack.env
# Read by `bun run dev:stack`. Only the names below are used; the stack generates its own session keys.

# A GitHub OAuth app for local use only (production's app cannot return to your machine).
# Callback URL: http://127.0.0.1/api/auth/github/callback  (GitHub allows any port on a loopback callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Without it, environments (VMs) show as not configured. VMs it creates are real and billed.
FREESTYLE_API_KEY=
# FREESTYLE_BASE_SNAPSHOT=morrow-base

# Optional. Hosted Relaycast by default; "disabled" turns Relay off.
# RELAY_BASE_URL=disabled
