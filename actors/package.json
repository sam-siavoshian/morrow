{
    "name": "actors",
    "private": true,
    "type": "module",
    "engines": {
        "bun": ">=1.4.2"
    },
    "scripts": {
        "dev": "durable-actors dev",
        "check": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
        "generate": "durable-actors generate src/actors.ts --out-dir generated",
        "test": "bun test --timeout 60000",
        "test-server": "bun scripts/test-server.ts"
    },
    "dependencies": {
        "durable-actors": "0.14.5",
        "terse-sdk": "0.14.8",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "@types/node": "^22.0.0",
        "typescript": "~5.9.3"
    },
    "trustedDependencies": [
        "esbuild"
    ]
}
