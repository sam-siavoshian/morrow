# Copy to deploy/mac-mini/backend.env (stays on your laptop, never in the repo). deploy.sh uploads it to the
# mini as ~/morrow/backend/.env with mode 0600. Every variable is described in backend/.env.example.

APP_ORIGIN=https://trymorrow.dev
# The mini's public Funnel host: https://<machine>.<tailnet>.ts.net becomes wss://<machine>.<tailnet>.ts.net
REALTIME_URL=wss://REPLACE-ME.ts.net
PORT=8787
# Only Tailscale Funnel (which proxies to localhost) may reach the backend. deploy.sh refuses anything else.
HOST=127.0.0.1

# openssl rand -base64 32, twice. They must differ.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# GitHub OAuth App, callback https://trymorrow.dev/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Terse Cloud: what `terse deploy` prints, and an API key from app.useterse.ai > API keys.
TERSE_ACTOR_URL=
TERSE_API_KEY=

FREESTYLE_API_KEY=

# Proxies in front of the backend that append the caller to X-Forwarded-For. Confirm on the live stack before
# opening sign-ups (deploy/README.md, "Client IP check"): a wrong value makes every visitor share one rate limit.
TRUSTED_PROXY_HOPS=0

# Invite-only while the stack is new. Comma-separated GitHub logins.
# SIGNUP_ALLOWLIST=
LOG_LEVEL=info
